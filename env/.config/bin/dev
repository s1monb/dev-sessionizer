#!/usr/bin/env bash
# Open or switch to a tmux session for a project.
#   dev          fuzzy-pick a git repo under the roots in ~/.devconfig
#                (one root per line; end a line with :N to search N folders deep, default 3)
#   dev PATH     open or switch to the session for PATH
#   dev --list   print the repos found under the roots, one per line
set -euo pipefail

roots_file="$HOME/.devconfig"
default_depth=3

die() {
  printf 'dev: %s\n' "$*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "$1 not found; install it first"
}

need_roots() {
  [[ -f $roots_file ]] ||
    die "$roots_file not found; create it with one project root per line, e.g. ~/github.com (add :N to search N folders deep, default 3)"
}

# Expands a leading ~ and $VAR / ${VAR}, left to right. Nothing is ever evaluated.
expand() {
  local s="$1" out="" name
  # shellcheck disable=SC2088  # matching a literal ~ from the roots file
  if [[ $s == "~" || $s == "~/"* ]]; then
    s="$HOME${s#\~}"
  fi
  while [[ $s =~ ^([^$]*)\$\{?([A-Za-z_][A-Za-z0-9_]*)\}?(.*)$ ]]; do
    name="${BASH_REMATCH[2]}"
    out="$out${BASH_REMATCH[1]}${!name-}"
    s="${BASH_REMATCH[3]}"
  done
  printf '%s' "$out$s"
}

# Prints the git repos up to DEPTH folders below ROOT, one level at a time. A repo is not
# searched further. Symlinks are skipped; hidden folders are included. Bash built-ins only.
scan() {
  local root="$1" depth="$2" level=0 dir d
  local -a current next
  shopt -s nullglob dotglob
  current=("$root")
  while ((level < depth && ${#current[@]})); do
    next=()
    for dir in "${current[@]}"; do
      for d in "$dir"/*/; do
        d="${d%/}"
        [[ -L $d ]] && continue
        if [[ -e $d/.git ]]; then
          printf '%s\n' "$d"
        else
          next+=("$d")
        fi
      done
    done
    current=(${next[@]+"${next[@]}"})
    level=$((level + 1))
  done
}

# Reads every root and its depth into roots/depths, so a bad line fails before any output.
# An optional ":N" ends a line; the depth is split off before the path is expanded.
roots=()
depths=()
read_roots() {
  need_roots
  local line path depth n=0
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n + 1))
    [[ -z $line || $line == \#* ]] && continue
    path="$line"
    depth="$default_depth"
    if [[ $line =~ ^(.*):([^/]*)$ ]]; then
      path="${BASH_REMATCH[1]}"
      depth="${BASH_REMATCH[2]}"
      [[ $depth =~ ^[1-9][0-9]*$ ]] ||
        die "$roots_file line $n: bad depth '$depth' (want a whole number of 1 or more)"
    fi
    path="$(expand "$path")"
    [[ -d $path ]] || continue
    roots+=("$path")
    depths+=("$depth")
  done <"$roots_file"
}

scan_roots() {
  local i=0
  while ((i < ${#roots[@]})); do
    scan "${roots[i]}" "${depths[i]}"
    i=$((i + 1))
  done
}

sanitize() {
  printf '%s' "$1" | tr -c 'A-Za-z0-9_-' '_'
}

open_session() {
  local dir name
  dir="$(cd "$1" 2>/dev/null && pwd)" || die "not a directory: $1"
  name="$(sanitize "$(basename "$dir")")"

  # Same name, different project: disambiguate with the parent folder.
  if tmux has-session -t "=$name" 2>/dev/null &&
    [[ $(tmux display-message -p -t "=$name:" '#{session_path}') != "$dir" ]]; then
    name="${name}_$(sanitize "$(basename "$(dirname "$dir")")")"
  fi

  tmux has-session -t "=$name" 2>/dev/null || tmux new-session -ds "$name" -c "$dir"

  [[ ${DS_DEV_NO_ATTACH:-} == 1 ]] && return 0
  if [[ -n ${TMUX:-} ]]; then
    tmux switch-client -t "=$name"
  else
    tmux attach -t "=$name"
  fi
}

if [[ ${1:-} == --list ]]; then
  read_roots
  scan_roots
  exit 0
fi

need tmux
if (($# == 1)); then
  target="$1"
else
  need fzf
  read_roots
  target="$(scan_roots | fzf)" || exit 0
fi
[[ -n $target ]] || exit 0
open_session "$target"
